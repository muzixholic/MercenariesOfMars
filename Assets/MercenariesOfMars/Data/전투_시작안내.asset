    portraitId: 
    text: "\uAC01 \uC720\uB2DB\uC740 \uC774\uB3D9 \uD6C4 \uACF5\uACA9 \uB610\uB294 \uB300\uAE30\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. G \uD0A4\uB85C \uACA9\uC790\uB97C \uC804\uD658\uD569\uB2C8\uB2E4. \uC544\uAD70 \uC804\uC6D0\uC774 \uD589\uB3D9\uD558\uBA74 \uC801\uAD70 \uD134\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
